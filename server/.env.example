# Example environment configurations

# SQLite Configuration (local machine deployment)
# DATABASE_URL="file:./app.db"

# PostgreSQL Configuration (local server)
# DATABASE_URL="postgresql://username:password@localhost:5432/goji_app?schema=public"

# PostgreSQL Configuration (cloud deployment - AWS RDS example)
# DATABASE_URL="postgresql://username:password@your-rds-endpoint.amazonaws.com:5432/goji_app?schema=public"

# PostgreSQL Configuration (cloud deployment - Google Cloud SQL example)
# DATABASE_URL="postgresql://username:password@your-cloud-sql-ip:5432/goji_app?schema=public"

# PostgreSQL Configuration (cloud deployment - Azure Database example)
# DATABASE_URL="postgresql://username:password@your-server.postgres.database.azure.com:5432/goji_app?schema=public"

# Server Configuration
PORT=3001
NODE_ENV=production

# JWT Secret (use a strong secret in production!)
JWT_SECRET=your-very-secure-production-jwt-secret-key

# CORS Origin (your frontend domain)
CORS_ORIGIN=https://your-domain.com

# User Registration Settings
REQUIRE_USER_APPROVAL=true
ALLOW_OPEN_REGISTRATION=false
DEFAULT_USER_ROLE=USER